<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">

	<Properties>
		<Property name="projectName">SHORTURL</Property>
		<Property name="port">8080</Property>
		<Property name="microservice">url-portal</Property>
	</Properties>

	<Appenders>
		<File name="FileAppender" fileName="logs/url-shortner/url-shortner.log" append="true">
			<PatternLayout>
				<Pattern>%d{yyyy-MM-dd HH:mm:ss} - %p - ${projectName} - [${port}] - [${microservice}] - [%X{user}] - [%X{ipAddress}] - [%pid{hash}] - [%tid{hash}] - [%X{apiEndPoint}] - %c - %M - %msg%n</Pattern>
			</PatternLayout>
		</File>
	
		<Console name="ConsoleAppender" target="SYSTEM_OUT">
			<PatternLayout>
				<Pattern>%d{yyyy-MM-dd HH:mm:ss} - %p - ${projectName} - [${port}] - [${microservice}] - [%X{user}] - [%X{ipAddress}] - [%pid{hash}] - [%tid{hash}] - [%X{apiEndPoint}] - %c - %M - %msg%n</Pattern>
			</PatternLayout>
		</Console>
	</Appenders>
	
	<Loggers>
		<Logger name="org.springframework.boot" level="INFO" additivity="false">
			<AppenderRef ref="ConsoleAppender"/>
		</Logger>
		<Logger name="org.springframework" level="WARN"/>
		<Root level="DEBUG">
			<AppenderRef ref="FileAppender" />
<!--			<AppenderRef ref="ConsoleAppender"/>-->
		</Root>
	</Loggers>

</Configuration>